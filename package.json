{
  "name": "tertoct",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "seed": "node scripts/seedFirestore.js",
    "notify": "node scripts/notifyExpiringPlans.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:rules": "firebase emulators:exec --project tertoct-e2e --only firestore \"jest src/security/firestore.rules.test.ts\"",
    "playwright:install": "playwright install chromium",
    "pretest:e2e": "npm run playwright:install",
    "test:e2e": "firebase emulators:exec --project tertoct-e2e --only firestore,auth \"playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --project tertoct-e2e --only firestore,auth \"playwright test --ui\""
  },
  "dependencies": {
    "@sentry/nextjs": "^10.56.0",
    "firebase": "^12.9.0",
    "firebase-admin": "^12.7.0",
    "isomorphic-dompurify": "^3.8.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
