rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Auth / roles ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    function isCoach() {
      let role = currentRole();
      return role == 'coach' || role == 'admin';
    }

    function isStudent() {
      return currentRole() == 'student';
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserPlanId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.planId
        : null;
    }

    function isCurrentUserActive() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && (
        !('active' in get(path).data) ||
        get(path).data.active == true
      );
    }

    function planIsActive(planId) {
      return planId is string &&
        exists(/databases/$(database)/documents/plans/$(planId)) &&
        get(/databases/$(database)/documents/plans/$(planId)).data.active == true;
    }

    // ── Users ─────────────────────────────────────────────────────────────

    function canCoachUpdateUser(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
        'planId',
        'active',
        'paymentDueDay',
        'monthlyPaymentPaid',
        'paymentValidUntil',
        'bio',
        'photoURL',
        'phone'
      ]);
    }

    function isValidSelfUserCreate(userId, data) {
      return userId == request.auth.uid &&
        data.role == 'student' &&
        (!('active' in data) || data.active == true) &&
        data.keys().hasOnly([
          'name',
          'email',
          'photoURL',
          'role',
          'planId',
          'active',
          'createdAt'
        ]);
    }

    function isPublicCoachProfile(data) {
      return data.role in ['coach', 'admin'] &&
        data.keys().hasOnly(['name', 'photoURL', 'role', 'bio', 'active']);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        userId == request.auth.uid ||
        (isCoach() && resource.data.role == 'student')
      );

      allow create: if isSignedIn() && isValidSelfUserCreate(userId, request.resource.data);

      allow update: if isSignedIn() && (
        (userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'photoURL'])) ||
        (isCoach() && canCoachUpdateUser(resource.data, request.resource.data))
      );

      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        (userId == request.auth.uid && isCoach()) ||
        isAdmin()
      ) && isPublicCoachProfile(request.resource.data);
      allow update: if isSignedIn() && (
        (userId == request.auth.uid && isCoach()) ||
        isAdmin()
      ) && isPublicCoachProfile(request.resource.data) &&
        !('active' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }

    // ── Plans (leitura pública; escrita só via API privada / Admin SDK) ───

    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ── Turmas (classes) ──────────────────────────────────────────────────
    // Alunos leem turmas ativas no client (listenActiveClasses).
    // CRUD de turmas: /api/private/classes (Admin SDK).

    match /classes/{classId} {
      allow read: if isSignedIn() && (
        isCoach() ||
        resource.data.active == true
      );
      allow create, update, delete: if false;
    }

    // ── Check-ins ─────────────────────────────────────────────────────────
    // Modelo:
    //   doc id: {userId}_{classId}_{classDateKey}
    //   campos: userId, planId, classId, classDateKey, weekKey, className, ...
    // Criação/cancelamento: POST/DELETE /api/private/checkins (Admin SDK).
    // Validações de negócio (plano, pagamento, capacidade, prazo, limite
    // semanal) ficam na API; regras bloqueiam escrita direta no cliente.

    function canReadCheckin(checkinData) {
      return isSignedIn() && (
        checkinData.userId == request.auth.uid ||
        isCoach()
      );
    }

    match /checkins/{checkinId} {
      allow read: if canReadCheckin(resource.data);
      allow create, update, delete: if false;
    }

    // Contador semanal por aluno: {userId}_{weekKey} (weekKey = ISO da segunda).
    // Atualizado apenas na transação da API de check-in.

    match /checkinCounters/{counterId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isCoach()
      );
      allow create, update, delete: if false;
    }

    // Contador de vagas por turma/dia: {classId}_{classDateKey}.
    // Alunos leem para exibir vagas restantes no fluxo de check-in.

    match /classCheckinCounters/{counterId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // ── Feedbacks ─────────────────────────────────────────────────────────

    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isCoach()
      );

      // Writes only via /api/private/feedback (Admin SDK).
      allow create, delete: if false;

      allow update: if false;
    }

    // ── Coleções futuras ──────────────────────────────────────────────────

    match /enrollments/{id} {
      allow read: if isCoach();
      allow create, update, delete: if isCoach();
    }

    match /payments/{id} {
      allow read, create: if isCoach() || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
